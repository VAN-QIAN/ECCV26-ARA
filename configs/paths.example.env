# Copy this file to configs/paths.env and replace the placeholders with
# machine-local paths. configs/paths.env is ignored by Git.

ECHOSIGHT_ROOT=/path/to/EchoSight
REFLECTIVA_ROOT=/path/to/ReflectiVA
COMEM_ROOT=/path/to/CoMEM
COMEM_CHECKPOINT_DIR=/path/to/checkpoints/CoMEM
WIKIPRF_ROOT=/path/to/Wiki-PRF
WIKIPRF_CHECKPOINT_DIR=/path/to/checkpoints/Wiki-PRF
WIKIPRF_INFOSEEK_UNFIXED_OUTPUT=/path/to/results_infoseek_unfixed_step600_Feb22_test_topk3.json_0_generation_details.jsonl
IBA_EVQA_FIXED_OUTPUT=/path/to/iba/evqa_fixed.jsonl
IBA_EVQA_UNFIXED_OUTPUT=/path/to/iba/evqa_unfixed.jsonl
IBA_INFOSEEK_FIXED_OUTPUT=/path/to/iba/infoseek_fixed.jsonl
IBA_INFOSEEK_UNFIXED_OUTPUT=/path/to/iba/infoseek_unfixed.jsonl

# Optional, only needed for EVQA BEM scoring without network/model download.
BEM_MODEL_DIR=/path/to/tfhub_models/bem

QWEN_VLLM_BASE_URL=http://127.0.0.1:8001/v1
EVQA_BEM_MODEL_PATH=https://tfhub.dev/google/answer_equivalence/bem/1
EVQA_BEM_VOCAB_PATH=gs://cloud-tpu-checkpoints/bert/keras_bert/uncased_L-12_H-768_A-12/vocab.txt
